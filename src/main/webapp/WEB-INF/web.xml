<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="4.0">
 <display-name>ThabithaMart</display-name><session-config><session-timeout>30</session-timeout></session-config>
 <listener><listener-class>com.thabitha.thabithamart.listener.AppListener</listener-class></listener>
 <servlet><servlet-name>auth</servlet-name><servlet-class>com.thabitha.thabithamart.controller.AuthServlet</servlet-class></servlet>
 <servlet-mapping><servlet-name>auth</servlet-name><url-pattern>/login</url-pattern></servlet-mapping>
 <servlet><servlet-name>home</servlet-name><servlet-class>com.thabitha.thabithamart.controller.HomeServlet</servlet-class></servlet>
 <servlet-mapping><servlet-name>home</servlet-name><url-pattern>/home</url-pattern></servlet-mapping>
 <servlet><servlet-name>logout</servlet-name><servlet-class>com.thabitha.thabithamart.controller.LogoutServlet</servlet-class></servlet>
 <servlet-mapping><servlet-name>logout</servlet-name><url-pattern>/logout</url-pattern></servlet-mapping>
 <servlet><servlet-name>placeholder</servlet-name><servlet-class>com.thabitha.thabithamart.controller.PlaceholderServlet</servlet-class></servlet>
 <servlet-mapping><servlet-name>placeholder</servlet-name><url-pattern>/feature/*</url-pattern></servlet-mapping>
 <welcome-file-list><welcome-file>login</welcome-file></welcome-file-list>
</web-app>